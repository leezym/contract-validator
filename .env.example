# Plantilla. Copie este archivo como .env (en la raíz del proyecto) y complete los valores.
# El archivo .env está en .gitignore: no se versiona ni se comparte. No pegue su contenido en chats ni tickets.
# Las variables reales del sistema, si existen, tienen prioridad sobre este archivo.

# Usuario y contraseña de Oracle (usar un usuario de SOLO LECTURA)
CV_ORACLE_USER=
CV_ORACLE_PASSWORD=

# Opcional: la conexión ya está en config/oracle.local.json. Descomente para usar otra.
# CV_ORACLE_HOST=servidor.empresa.com
# CV_ORACLE_PORT=1521
# CV_ORACLE_SID=NOMBRE_SID
# CV_ORACLE_SERVICE=nombre_servicio
# CV_ORACLE_DSN=servidor.empresa.com:1521/nombre_servicio
